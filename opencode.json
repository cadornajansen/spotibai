          }
        },

        "gpt-5.6-terra": {
          "name": "GPT-5.6 Terra",
          "options": {
            "reasoningEffort": "none"
          }
        },

        "gpt-5.6-sol": {
          "name": "GPT-5.6 Sol",
          "options": {
            "reasoningEffort": "none"
          }
        },

        "claude-haiku-4-5-20251001": {
