---
import { Play } from 'lucide-astro';
import type { Track } from '../types/library';

interface Props { track: Track; index: number; }
const { track, index } = Astro.props;
---

<button type="button" class="group flex w-full items-center gap-3 rounded-lg px-2 py-2 text-left transition hover:bg-white/7" data-track-id={track.id} aria-label={`Play ${track.title}`}>
  <span class="w-4 text-center text-xs text-slate-500 group-hover:hidden">{index + 1}</span><span class="hidden w-4 text-center text-lime group-hover:block"><Play size={13} fill="currentColor" /></span>
  <img class="size-10 rounded-md object-cover" src={track.cover} alt={`${track.title} cover`} width="40" height="40" loading="lazy" />
  <span class="min-w-0 flex-1"><span class="block truncate text-sm font-semibold text-slate-100">{track.title}</span><span class="block truncate text-xs text-slate-500">{track.artist}</span></span>
  <span class="pr-2 text-xs tabular-nums text-slate-500">{track.duration}</span>
</button>
