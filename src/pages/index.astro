---
import MusicCard from '../components/MusicCard.astro';
import LyricsView from '../components/LyricsView.astro';
import NowPlayingPanel from '../components/NowPlayingPanel.astro';
import PlayerBar from '../components/PlayerBar.astro';
import PlaylistView from '../components/PlaylistView.astro';
import Sidebar from '../components/Sidebar.astro';
import Topbar from '../components/Topbar.astro';
import TrackRow from '../components/TrackRow.astro';
import '../styles/global.css';
import catalogData from '../data/spotify.json';
import spotifyLogo from '../assets/spotify-logo.png';
import { madeForYou, nowPlaying, playlists, recentlyAdded, topTracks, tracks } from '../data/spotify';

const greeting = 'Good afternoon';

const siteUrl = (import.meta.env.PUBLIC_SITE_URL || process.env.PUBLIC_SITE_URL || 'https://example.com').replace(/\/+$/, '');
const canonicalUrl = `${siteUrl}/`;
const ogImageUrl = new URL(spotifyLogo.src, siteUrl).href;

const toIsoDuration = (seconds: number | null | undefined): string | undefined => {
  if (!seconds || !Number.isFinite(seconds) || seconds <= 0) return undefined;
  const mins = Math.floor(seconds / 60);
  const secs = Math.round(seconds % 60);
  return `PT${mins}M${secs}S`;
};

const songMetaById = new Map(catalogData.songs.map((s) => [s.id, s]));

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      url: canonicalUrl,
      name: 'Spotibai',
      description: 'Stream and discover tracks, community parodies, and curated playlists on Spotibai, a fictional web music player and song catalogue.',
      inLanguage: 'en-US',
    },
    {
      '@type': 'Organization',
      '@id': `${siteUrl}/#organization`,
      name: 'Spotibai',
      url: canonicalUrl,
      logo: {
        '@type': 'ImageObject',
        url: ogImageUrl,
        width: 512,
        height: 512,
      },
    },
    ...playlists.map((playlist) => {
      const playlistCoverUrl = playlist.cover.startsWith('http') ? playlist.cover : new URL(playlist.cover, siteUrl).href;
      return {
        '@type': 'MusicPlaylist',
        '@id': `${siteUrl}/#playlist-${playlist.id}`,
        name: playlist.title,
        description: playlist.description,
        numTracks: playlist.tracks.length,
        image: playlistCoverUrl,
        track: playlist.tracks.map((t) => ({
          '@type': 'MusicRecording',
          '@id': `${siteUrl}/#track-${t.id}`,
          name: t.title,
          byArtist: {
            '@type': 'MusicGroup',
            name: t.artist,
          },
        })),
      };
    }),
    ...tracks.map((track) => {
      const original = songMetaById.get(track.id);
      const trackCoverUrl = track.cover.startsWith('http') ? track.cover : new URL(track.cover, siteUrl).href;
      const trackAudioUrl = track.audioSrc ? (track.audioSrc.startsWith('http') ? track.audioSrc : new URL(track.audioSrc, siteUrl).href) : undefined;
      return {
        '@type': 'MusicRecording',
        '@id': `${siteUrl}/#track-${track.id}`,
        url: `${siteUrl}/#track-${track.id}`,
        name: track.title,
        byArtist: {
          '@type': 'MusicGroup',
          name: track.artist,
        },
        duration: toIsoDuration(original?.durationSeconds),
        image: trackCoverUrl,
        ...(trackAudioUrl ? { audio: trackAudioUrl } : {}),
      };
    }),
  ],
};

const safeJsonLd = JSON.stringify(structuredData).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Spotibai — Streaming Web Player & Fictional Music Catalogue</title>
    <meta name="description" content="Stream and discover tracks, community parodies, and curated playlists on Spotibai, a fictional web music player and song catalogue." />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="theme-color" content="#121212" />
    <meta name="robots" content="index, follow" />
    <meta name="googlebot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />

    <!-- Open Graph / Facebook -->
    <meta property="og:site_name" content="Spotibai" />
    <meta property="og:title" content="Spotibai — Streaming Web Player & Fictional Music Catalogue" />
    <meta property="og:description" content="Stream and discover tracks, community parodies, and curated playlists on Spotibai, a fictional web music player and song catalogue." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content="Spotibai music player logo" />
    <meta property="og:image:width" content="512" />
    <meta property="og:image:height" content="512" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="Spotibai — Streaming Web Player & Fictional Music Catalogue" />
    <meta name="twitter:description" content="Stream and discover tracks, community parodies, and curated playlists on Spotibai, a fictional web music player and song catalogue." />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content="Spotibai music player logo" />

    <!-- Favicons & App Icons -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <!-- Structured Data (JSON-LD) -->
    <script is:inline type="application/ld+json" set:html={safeJsonLd}></script>
  </head>
  <body>
    <div class="flex h-screen overflow-hidden bg-[#000]" data-music-app>
      <Sidebar playlists={playlists} nowPlaying={nowPlaying} />
      <main class="app-scroll h-screen min-w-0 flex-1 overflow-y-auto pb-40 lg:pb-28">
        <Topbar />
        <div class="px-4 pb-12 pt-6 sm:px-7 xl:px-9 animate-fade-in" data-home-view>
          <h1 class="sr-only">Spotibai — Streaming Web Player & Fictional Music Catalogue</h1>
          <p class="text-2xl font-bold tracking-tight text-white sm:text-3xl" data-greeting>{greeting}</p>
          <section class="mt-6 animate-fade-in delay-1" aria-label="Quick picks">
            <div class="grid grid-cols-1 gap-2 sm:grid-cols-2 2xl:grid-cols-4">
              {topTracks.map((item) => <MusicCard item={item} variant="quick" />)}
            </div>
          </section>

          <section class="mt-10 animate-fade-in delay-2" aria-labelledby="made-for-you">
            <div class="mb-3 flex items-end justify-between"><h2 id="made-for-you" class="text-2xl font-bold tracking-tight text-white">Made for you</h2><button class="text-sm font-bold text-[#b3b3b3] hover:underline hover:text-white transition-colors">Show all</button></div>
            <div class="grid grid-cols-2 gap-2 sm:grid-cols-3 xl:grid-cols-4 2xl:grid-cols-6">{madeForYou.map((item) => <MusicCard item={item} />)}</div>
          </section>

          <section class="mt-10 animate-fade-in delay-3" aria-labelledby="recently-added">
            <div class="mb-3 flex items-end justify-between"><h2 id="recently-added" class="text-2xl font-bold tracking-tight text-white">Recently added</h2><button class="text-sm font-bold text-[#b3b3b3] hover:underline hover:text-white transition-colors">Show all</button></div>
            <div class="grid max-w-3xl gap-x-5 sm:grid-cols-2">{recentlyAdded.map((item, index) => <TrackRow track={tracks.find((track) => track.id === item.trackId)!} index={index} />)}</div>
          </section>

          <section class="mt-10 animate-fade-in delay-4" id="library" aria-labelledby="weird-playlists">
            <div class="mb-3 flex items-end justify-between"><h2 id="weird-playlists" class="text-2xl font-bold tracking-tight text-white">Your weirdest playlists</h2><button class="text-sm font-bold text-[#b3b3b3] hover:underline hover:text-white transition-colors">Show all</button></div>
            <div class="grid grid-cols-2 gap-2 sm:grid-cols-3 xl:grid-cols-4">{playlists.map((item) => <MusicCard item={item} />)}</div>
          </section>
        </div>
        <section class="hidden px-4 pb-12 pt-7 sm:px-7 xl:px-9 animate-fade-in" data-search-view aria-label="Search results">
          <p class="text-sm text-[#b3b3b3]" data-search-summary>Start typing to search your local music.</p>
          <div class="mt-5 space-y-1" data-search-results></div>
        </section>
        {playlists.map((playlist) => <PlaylistView playlist={playlist} />)}
        <LyricsView track={nowPlaying} />
      </main>
      <NowPlayingPanel track={nowPlaying} />
    </div>
    <PlayerBar track={nowPlaying} />
    <script src="../scripts/player.ts"></script>
  </body>
</html>
