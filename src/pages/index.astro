---
import AppLayout from '../layouts/AppLayout.astro';
import { nowPlaying, tracks } from '../data/spotify';

const trackId = Astro.url.searchParams.get('track') || Astro.url.searchParams.get('song');
const activeTrack = (trackId ? tracks.find((t) => t.id === trackId) : null) ?? nowPlaying;
---

<AppLayout activeTrack={activeTrack} />
