---
import { ChevronDown, Heart, ListMusic, Maximize2, Pause, Play, SkipBack, SkipForward, Volume2 } from 'lucide-astro';
import type { Track } from '../types/library';

interface Props { track: Track; }
const { track } = Astro.props;
---

<footer class="fixed inset-x-0 bottom-14 z-30 grid h-[72px] grid-cols-[minmax(0,1fr)_auto] items-center gap-3 border-t border-line bg-[#181818]/98 backdrop-blur-md px-3 lg:bottom-0 lg:h-[88px] lg:grid-cols-[minmax(210px,1fr)_minmax(310px,520px)_minmax(210px,1fr)] lg:px-5" aria-label="Music player">
  <div class="flex min-w-0 items-center gap-3"><img class="size-11 rounded object-cover shadow-sm transition-opacity duration-200 lg:size-14" src={track.cover} alt="" width="56" height="56" data-player-cover /><div class="min-w-0"><strong class="block truncate text-sm text-white transition-colors duration-150" data-player-title>{track.title}</strong><span class="block truncate text-xs text-[#b3b3b3]" data-player-artist>{track.artist}</span></div><button type="button" class="ml-auto hidden items-center gap-1.5 text-[#b3b3b3] hover:text-lime active:scale-90 transition-all duration-150 disabled:cursor-wait disabled:opacity-60 sm:flex" data-like-button aria-label={`Like ${track.title}`} aria-pressed="false"><Heart size={18} class="transition-transform duration-150" data-like-icon /><span class="min-w-3 text-xs tabular-nums" data-like-count>0</span></button><span class="sr-only" role="status" aria-live="polite" data-like-status></span></div>
  <div class="hidden w-full lg:block"><div class="flex items-center justify-center gap-4"><button type="button" class="text-[#b3b3b3] transition-all duration-150 hover:text-white hover:scale-105 active:scale-90" aria-label="Previous track" data-player-previous><SkipBack size={19} fill="currentColor" /></button><button type="button" class="grid size-9 place-items-center rounded-full bg-white text-black shadow-md transition-all duration-150 hover:scale-105 active:scale-95" aria-label="Pause" data-play-toggle><Pause size={19} fill="currentColor" data-pause-icon /><Play class="hidden" size={19} fill="currentColor" data-play-icon /></button><button type="button" class="text-[#b3b3b3] transition-all duration-150 hover:text-white hover:scale-105 active:scale-90" aria-label="Next track" data-player-next><SkipForward size={19} fill="currentColor" /></button></div><div class="mt-2 flex items-center gap-2 text-[10px] tabular-nums text-[#b3b3b3]"><span data-elapsed>0:00</span><input class="player-progress flex-1" type="range" min="0" max="100" value="0" aria-label="Seek through current track" data-seek /><span data-player-duration>{track.duration}</span></div></div>
  <div class="flex items-center justify-end gap-3 text-[#b3b3b3]"><button type="button" class="grid size-8 place-items-center rounded-full transition-all duration-150 hover:text-white hover:scale-105 active:scale-90 lg:hidden" aria-label="Pause" data-play-toggle><Pause size={18} fill="currentColor" data-pause-icon /><Play class="hidden" size={18} fill="currentColor" data-play-icon /></button><button type="button" class="hidden xl:block transition-colors hover:text-white active:scale-95" aria-label="Queue"><ListMusic size={18} /></button><Volume2 class="hidden xl:block" size={18} /><input class="player-progress hidden w-20 xl:block" type="range" min="0" max="100" value="66" aria-label="Volume" data-volume /><button type="button" class="hidden xl:block transition-colors hover:text-white active:scale-95" aria-label="Open player"><Maximize2 size={17} /></button><ChevronDown class="hidden sm:block lg:hidden" size={17} /></div>
</footer>
<audio data-audio preload="metadata" src={track.audioSrc}></audio>
