---
import { Heart, ListPlus, MoreHorizontal } from 'lucide-astro';
import type { Track } from '../types/library';

interface Props { track: Track; }
const { track } = Astro.props;
---

<aside class="m-2 ml-0 hidden h-[calc(100dvh-104px)] w-[360px] shrink-0 rounded-lg bg-[#121212] p-5 xl:block" aria-label="Now playing">
  <div class="flex items-center justify-between"><span class="text-xs font-bold tracking-[0.12em] text-white">NOW PLAYING</span><button type="button" class="grid size-8 place-items-center rounded-full text-[#b3b3b3] transition-all hover:text-white hover:scale-105 active:scale-90" aria-label="More options"><MoreHorizontal size={18} /></button></div>
  <div class="mt-5 overflow-hidden rounded-md bg-[#181818] shadow-lg"><video class="aspect-square w-full object-cover transition-opacity duration-300" data-now-video src={track.videoSrc} muted playsinline></video><img class="hidden aspect-square w-full object-cover transition-opacity duration-300" src={track.cover} alt={`${track.title} cover`} width="320" height="320" data-now-cover /></div>
  <div class="mt-4 flex items-start gap-3"><div class="min-w-0 flex-1"><h2 class="truncate text-lg font-bold tracking-tight text-white transition-colors duration-150" data-now-title>{track.title}</h2><p class="mt-0.5 truncate text-sm text-[#b3b3b3]" data-now-artist>{track.artist}</p></div><button type="button" class="flex min-h-9 items-center gap-1 rounded-full px-2 text-[#b3b3b3] hover:text-lime active:scale-90 transition-all duration-150 disabled:cursor-wait disabled:opacity-60" data-like-button aria-label={`Like ${track.title}`} aria-pressed="false"><Heart size={19} class="transition-transform duration-150" data-like-icon /><span class="min-w-3 text-xs tabular-nums" data-like-count>0</span></button><button type="button" class="grid size-9 place-items-center rounded-full text-[#b3b3b3] transition-all hover:text-white hover:scale-105 active:scale-90" aria-label="Add current track to a playlist"><ListPlus size={19} /></button></div>
</aside>
