---
import {
  BookOpen,
  ChevronLeft,
  Home,
  Library,
  Plus,
  Search,
} from "lucide-astro";
import spotifyLogo from "../assets/spotify-logo.png";
import type { Playlist, Track } from "../types/library";

interface Props {
  playlists: Playlist[];
  nowPlaying: Track;
}

const { playlists, nowPlaying } = Astro.props;
---

<aside
  class="m-2 hidden h-[calc(100dvh-104px)] w-[300px] shrink-0 flex-col rounded-lg bg-[#121212] p-5 lg:flex xl:w-[312px]"
>
  <a
    class="mb-7 flex items-center gap-2 text-xl font-bold tracking-[-0.06em] text-white"
    href="/"
    aria-label="Spotibai home"
  >
    <img class="size-8" src={spotifyLogo.src} alt="" width="32" height="32" />
    Spotibai
  </a>

  <nav aria-label="Primary" class="space-y-1">
    <a
      class="flex items-center gap-3 rounded-md px-3 py-2.5 text-sm font-bold text-white"
      href="/"><Home size={18} fill="currentColor" /> Home</a
    >
    <button
      class="flex w-full items-center gap-3 rounded-md px-3 py-2.5 text-sm font-bold text-[#b3b3b3] transition hover:text-white"
      type="button"
      data-focus-search><Search size={18} /> Search</button
    >
  </nav>

  <section
    class="mt-7 flex min-h-0 flex-1 flex-col"
    aria-labelledby="library-heading"
  >
    <div class="flex items-center justify-between px-2">
      <h2
        id="library-heading"
        class="flex items-center gap-2 text-sm font-bold text-white"
      >
        <Library size={17} /> Your Library
      </h2>
      <button
        type="button"
        class="flex items-center gap-1 rounded-full bg-[#242424] px-3 py-2 text-sm font-bold text-white transition hover:bg-[#2f2f2f]"
        aria-label="Create a playlist"><Plus size={17} /> Create</button
      >
    </div>
    <div class="mt-4 flex gap-2 px-1">
      <button
        type="button"
        class="rounded-full bg-[#2a2a2a] px-3 py-1.5 text-xs font-bold text-white"
        >Playlists</button
      >
      <button
        type="button"
        class="rounded-full bg-[#2a2a2a] px-3 py-1.5 text-xs font-bold text-white transition hover:bg-[#333]"
        >Artists</button
      >
    </div>
    <div
      class="mt-5 flex items-center justify-between px-2 text-sm text-[#b3b3b3]"
    >
      <Search size={19} /><span>Recents</span>
    </div>
    <div class="mt-3 min-h-0 space-y-1 overflow-hidden pb-4">
      {
        playlists.map((playlist) => (
          <button
            type="button"
            class="group flex w-full items-center gap-3 rounded-md p-2 text-left transition hover:bg-[#1f1f1f]"
            data-playlist-id={playlist.id}
            aria-label={`Open ${playlist.title}`}
          >
            <img
              class="size-12 rounded object-cover"
              src={playlist.cover}
              alt=""
              width="48"
              height="48"
              loading="lazy"
            />
            <span class="min-w-0">
              <>
                <span class="block truncate text-sm font-bold text-white">
                  {playlist.title}
                </span>
                <span class="block truncate text-xs text-[#b3b3b3]">
                  Playlist · Spotibai
                </span>
              </>
            </span>
          </button>
        ))
      }
    </div>
  </section>

  <button
    type="button"
    class="flex items-center gap-2 rounded-lg bg-[#181818] p-2 text-left transition hover:bg-[#222]"
    data-track-id={nowPlaying.id}
    aria-label={`Play ${nowPlaying.title}`}
  >
    <img
      class="size-10 rounded object-cover"
      src={nowPlaying.cover}
      alt=""
      width="40"
      height="40"
      loading="lazy"
    />
    <span class="min-w-0 flex-1"
      ><span class="block truncate text-xs font-bold text-white"
        >{nowPlaying.title}</span
      ><span class="block truncate text-[11px] text-[#b3b3b3]"
        >{nowPlaying.artist}</span
      ></span
    >
    <ChevronLeft size={15} class="rotate-180 text-[#b3b3b3]" />
  </button>
</aside>

<nav
  class="fixed inset-x-0 bottom-0 z-40 flex h-14 items-center justify-around border-t border-line bg-[#000] px-3 lg:hidden"
  aria-label="Mobile navigation"
>
  <a
    class="grid place-items-center gap-0.5 text-[10px] font-bold text-white"
    href="/"><Home size={19} fill="currentColor" />Home</a
  >
  <button
    class="grid place-items-center gap-0.5 text-[10px] font-semibold text-[#b3b3b3]"
    type="button"
    data-focus-search><Search size={19} />Search</button
  >
  <a
    class="grid place-items-center gap-0.5 text-[10px] font-semibold text-[#b3b3b3]"
    href="#library"><BookOpen size={19} />Library</a
  >
</nav>
