{
  "$schema": "https://opencode.ai/config.json",

  "model": "assemblyai/gpt-5.6-luna",
  "small_model": "assemblyai/gpt-5-mini",

  "plugin": ["@upstash/context7-opencode"],

  "mcp": {
    "anysearch": {
      "type": "remote",
      "url": "https://api.anysearch.com/mcp",
      "enabled": true,
      "oauth": false,
      "timeout": 10000,
      "headers": {
        "Authorization": "Bearer {env:ANYSEARCH_API_KEY}"
      }
    }
  },

  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },

  "agent": {
    "build": {
      "mode": "primary",
      "permission": {
        "task": {
          "*": "deny",
          "explore": "allow"
        }
      }
    },

    "plan": {
      "mode": "primary",
      "model": "assemblyai/gpt-5.6-sol",
      "steps": 8,
      "permission": {
        "task": "deny"
      }
    },

    "explore": {
      "description": "Fast read-only repository exploration",
      "mode": "subagent",
      "model": "opencode/mimo-v2.5-free",
      "steps": 8,
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "lsp": "allow",
        "list": "allow",

        "edit": "deny",
        "bash": "deny",
        "task": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "skill": "deny"
      }
    }
  },

  "provider": {
    "assemblyai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "AssemblyAI LLM Gateway",

      "options": {
        "baseURL": "https://llm-gateway.assemblyai.com/v1",
        "headers": {
          "Authorization": "{env:ASSEMBLYAI_API_KEY}"
        }
      },

      "models": {
        "gpt-5-nano": {
          "name": "GPT-5 Nano",
          "options": {
            "reasoningEffort": "none"
          }
        },

        "gpt-5-mini": {
          "name": "GPT-5 Mini",
          "options": {
            "reasoningEffort": "none"
          }
        },

        "gpt-4.1": {
          "name": "GPT-4.1"
        },

        "gpt-5": {
          "name": "GPT-5",
          "options": {
            "reasoningEffort": "none"
          }
        },

        "gpt-5.1": {
          "name": "GPT-5.1",
          "options": {
            "reasoningEffort": "none"
          }
        },

        "gpt-5.2": {
          "name": "GPT-5.2",
          "options": {
            "reasoningEffort": "none"
          }
        },

        "gpt-5.5": {
          "name": "GPT-5.5",
          "options": {
            "reasoningEffort": "none"
          }
        },

        "gpt-5.6-luna": {
          "name": "GPT-5.6 Luna",
          "options": {
