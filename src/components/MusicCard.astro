---
import { Play } from 'lucide-astro';
import type { CollectionCard, Playlist } from '../types/library';

interface Props {
  item: CollectionCard | Playlist;
  compact?: boolean;
  variant?: 'card' | 'quick';
}

const { item, compact = false, variant = 'card' } = Astro.props;
const isPlaylist = 'tracks' in item;
const itemTarget = isPlaylist ? { 'data-playlist-id': item.id } : { 'data-track-id': item.trackId };
const description = item.description ?? ('artist' in item ? item.artist : undefined);
---

{variant === 'quick' ? (
  <article class="min-w-0">
    <button class="group flex h-16 w-full items-center overflow-hidden rounded-md bg-[#2a2a2a] text-left transition hover:bg-[#3a3a3a]" {...itemTarget} aria-label={`${isPlaylist ? 'Open' : 'Play'} ${item.title}`}>
      <img class="size-16 shrink-0 object-cover" src={item.cover} alt={`${item.title} cover`} width="64" height="64" loading="lazy" />
      <span class="min-w-0 flex-1 truncate px-3 text-sm font-bold text-white">{item.title}</span>
      <span class="mr-3 grid size-10 shrink-0 place-items-center rounded-full bg-lime text-black opacity-0 transition group-hover:opacity-100"><Play size={18} fill="currentColor" /></span>
    </button>
  </article>
) : (
  <article class:list={["group relative min-w-0 rounded-md p-3 transition hover:bg-[#1f1f1f]", compact ? "w-[158px] sm:w-[174px]" : "w-full"]}>
    <button class="block w-full text-left" {...itemTarget} aria-label={`${isPlaylist ? 'Open' : 'Play'} ${item.title}`}>
      <div class="relative aspect-square overflow-hidden rounded bg-panel-raised">
        <img class="size-full object-cover" src={item.cover} alt={`${item.title} cover`} width="200" height="200" loading="lazy" />
        <span class="absolute bottom-2 right-2 grid size-10 place-items-center rounded-full bg-lime text-black opacity-0 transition group-hover:opacity-100"><Play size={19} fill="currentColor" /></span>
      </div>
      <h3 class="mt-3 truncate text-sm font-bold text-white">{item.title}</h3>
      <p class="mt-1 line-clamp-2 text-xs leading-5 text-[#b3b3b3]">{description}</p>
    </button>
  </article>
)}
